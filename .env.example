# ---------------------------------------------------------------------------
# Copy to .env and fill in.  cp .env.example .env
# ---------------------------------------------------------------------------

# ----------------------------------------------------------------- application
APP_NAME=fastapi-langgraph-mcp
ENVIRONMENT=local
DEBUG=false
API_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ALLOW_ORIGINS=*

# ------------------------------------------------------------------------ llm
# Which vendor serves every model. Google Gemini is the default; the other
# registered names (anthropic, openai, openai_compatible, azure_openai,
# bedrock, ollama, groq, mistral) each need their extra installed first,
# e.g. pip install -e '.[openai]'.
LLM_PROVIDER=google_genai

# Required. Get one at https://aistudio.google.com/app/apikey
# GOOGLE_GENAI_API_KEY is also accepted; LLM_API_KEY overrides both.
GOOGLE_API_KEY=AIzaSyC5RbIcP1rHGEk1TPUfqyx0kDNnsQDQ

# Gemini 3.7 Flash is the default. Override per-role if you want a different
# model for the supervisor (routing is a light task) than for the workers.
LLM_MODEL=gemini-3.7-flash
# LLM_SUPERVISOR_MODEL=
# Route only the supervisor at a different vendor, if you want one.
# LLM_SUPERVISOR_PROVIDER=google_genai

# Output-token ceiling (sent as Gemini's max_output_tokens). Keep headroom: the
# endpoints stream, so a large ceiling costs nothing when it goes unused.
LLM_MAX_TOKENS=64000

# Gemini accepts both; leave unset to use the model's own defaults.
# LLM_TEMPERATURE=0.7
# LLM_TOP_P=0.95

# Anthropic-shaped thinking controls — read only by the anthropic provider and
# ignored under Gemini. Gemini's reasoning knobs are model-dependent, so pass
# them explicitly when your model supports them, e.g.
# LLM_EXTRA_PARAMS={"thinking_budget": 8192, "include_thoughts": true}
LLM_EFFORT=high
LLM_THINKING=adaptive
LLM_THINKING_DISPLAY=summarized

LLM_TIMEOUT_SECONDS=600
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------- graph
GRAPH_RECURSION_LIMIT=40
# memory | none  (memory = per-process threads; use Postgres for multi-replica)
GRAPH_CHECKPOINTER=memory
# last_message keeps the supervisor's context small; full_history gives it
# every worker tool call.
GRAPH_SUPERVISOR_OUTPUT_MODE=last_message
# Emit worker-internal steps with their namespace instead of collapsing them.
GRAPH_STREAM_SUBGRAPHS=true
# Every mode LangGraph 1.x supports. Trim if a client only needs some of them.
GRAPH_STREAM_MODES=values,updates,messages,custom,tasks,checkpoints,debug

# ------------------------------------------------------------------------ mcp
# >>> PLACEHOLDERS — replace with your real MCP endpoints. <<<
# Any URL left blank or still containing "<...>" is treated as unconfigured:
# that agent simply starts with no MCP tools and the service still boots.
#
# transport: streamable_http (recommended) | sse | websocket
# headers:   JSON object, e.g. {"Authorization": "Bearer <token>"}

# research_agent -> external lookup / web / third-party APIs
MCP_RESEARCH_URL=<https://your-research-mcp-server.example.com/mcp>
MCP_RESEARCH_TRANSPORT=streamable_http
MCP_RESEARCH_HEADERS={}

# knowledge_agent -> internal documents, records, databases
MCP_KNOWLEDGE_URL=<https://your-knowledge-mcp-server.example.com/mcp>
MCP_KNOWLEDGE_TRANSPORT=streamable_http
MCP_KNOWLEDGE_HEADERS={}

# automation_agent -> actions in external systems
MCP_AUTOMATION_URL=<https://your-automation-mcp-server.example.com/mcp>
MCP_AUTOMATION_TRANSPORT=streamable_http
MCP_AUTOMATION_HEADERS={}

# Fail startup when an MCP server is unreachable. Leave false in local dev so
# the API still boots without MCP.
MCP_REQUIRED=false
MCP_CONNECT_TIMEOUT_SECONDS=30

# Extra servers beyond the three above, as a JSON object. Reference the keys
# from an AgentSpec's `mcp_servers` tuple in app/agents/specs.py.
# MCP_EXTRA_SERVERS={"github":{"url":"https://api.githubcopilot.com/mcp/","transport":"streamable_http","headers":{"Authorization":"Bearer <token>"}}}
