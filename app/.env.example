=======
# Which vendor serves the models. One of:
#   anthropic | openai | openai_compatible | azure_openai | google_genai
#   bedrock   | ollama | groq              | mistral
# Only `anthropic` is installed by default — the rest are optional extras:
#   pip install -e ".[openai]"   (or .[google], .[bedrock], .[ollama], .[all-providers])
# GET /api/v1/agents/providers lists them with their install status.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5

# The supervisor only routes, so it can run on a cheaper vendor/model than the
# workers. Both fall back to LLM_PROVIDER / LLM_MODEL when unset.
# LLM_SUPERVISOR_PROVIDER=openai
# LLM_SUPERVISOR_MODEL=gpt-4o-mini

# --- credentials -------------------------------------------------------------
# Set the one matching your provider. LLM_API_KEY is a generic override that
# wins over all of them; bedrock and ollama need none.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# AZURE_OPENAI_API_KEY=
# LLM_API_KEY=

# --- provider-specific -------------------------------------------------------
# openai_compatible (vLLM, LiteLLM, OpenRouter, Together…) and ollama:
# LLM_BASE_URL=http://localhost:8000/v1

# azure_openai addresses a deployment, not a bare model name:
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your-deployment
# AZURE_OPENAI_API_VERSION=2024-10-21

# bedrock uses the standard AWS credential chain; model ids carry a prefix
# (e.g. anthropic.claude-opus-5):
# AWS_REGION=us-east-1

# Sampling knobs, applied only where the provider supports them. Claude Opus 5
# and Sonnet 5 reject temperature/top_p with a 400, so the Anthropic adapter
# drops them — steer those models through prompting instead.
# LLM_TEMPERATURE=0.2
# LLM_TOP_P=0.95

# Anything else passed straight to the vendor constructor, as JSON.
# LLM_EXTRA_PARAMS={"seed": 42}
>>>>>>> Stashed changes

# Gemini 3.7 Flash is the default. Override per-role if you want a different
# model for the supervisor (routing is a light task) than for the workers.
LLM_MODEL=gemini-3.7-flash
# LLM_SUPERVISOR_MODEL=
# Route only the supervisor at a different vendor, if you want one.
# LLM_SUPERVISOR_PROVIDER=google_genai

# Output-token ceiling (sent as Gemini's max_output_tokens). Keep headroom: the
# endpoints stream, so a large ceiling costs nothing when it goes unused.
LLM_MAX_TOKENS=64000

