# Base URL of the FastAPI service, including its API prefix.
# Left empty in development so requests go through the Vite proxy (see vite.config.ts).
VITE_API_BASE_URL=

# Where the Vite dev proxy forwards /api to.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# The prefix the backend mounts its router under (app/core/config.py: api_prefix).
VITE_API_PREFIX=/api/v1

# Request timeout in milliseconds for non-streaming calls.
# Supervisor runs are streamed, so this only bounds the small JSON endpoints.
VITE_API_TIMEOUT_MS=30000

# Graph stream modes requested from POST /chat/stream.
VITE_STREAM_MODES=updates,messages,custom
