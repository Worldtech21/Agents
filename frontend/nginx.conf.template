# Rendered to /etc/nginx/conf.d/default.conf at container start; only ${BACKEND_*}
# is substituted (NGINX_ENVSUBST_FILTER), so nginx's own $variables survive.

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # The GCLB terminates TLS and forwards the client address in the header.
    real_ip_header X-Forwarded-For;
    set_real_ip_from 0.0.0.0/0;

    # No cap on the request body: 0 disables the check entirely, so uploads are
    # bounded by the backend and by disk, not by nginx.
    client_max_body_size 0;
    client_body_buffer_size 1m;

    # A slow client on a huge upload must not be reaped mid-transfer.  These are
    # per-read/write idle timeouts, not wall-clock budgets for the request.
    client_body_timeout 1d;
    client_header_timeout 1d;
    send_timeout 1d;
    keepalive_timeout 1d;

    gzip on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Probe target for the kubelet: cheap, and independent of the SPA bundle.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # Vite fingerprints everything it emits under /assets, so those files are
    # safe to cache forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # The shell must never be cached, or a rollout leaves clients pinned to the
    # asset hashes of the previous image.
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    location /api/ {
        # kube-dns, read off the pod's own resolv.conf at start up.  The
        # upstream is held in a variable so nginx resolves it per request
        # instead of at config load, where a missing API Service would be a
        # fatal "host not found in upstream" and crashloop this pod.
        resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;
        set $backend ${BACKEND_ORIGIN};

        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Supervisor runs stream over SSE: nothing may buffer them, and the
        # connection has to outlive the 60s default read timeout.
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_connect_timeout 75s;
        proxy_read_timeout 1d;
        proxy_send_timeout 1d;

        # Stream the body straight through instead of spooling the whole upload
        # to a temp file before the backend sees a single byte.
        proxy_request_buffering off;
        client_max_body_size 0;
    }

    # Routing is client-side, so unknown paths fall back to the shell.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
